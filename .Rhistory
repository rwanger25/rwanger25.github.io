# Sub-sub-subet Blocks
chamber_inoc <- c("Chamber 1", "Chamber 2")
#setting the seed
set.seed(25)
# creating a function to assign treatments as evenly as possible
even_randomize_chamber <- function(n, chamber_inoc) { #inputs number of individuals in a block and 4 treatment labels
base_count <- floor(n / length(chamber_inoc)) #minimum of individuals per treatment by dividing total number in, floor rounds down
remainder  <- n %% length(chamber_inoc) # finding the remaining individuals that could not be evenly distributed across the treatments
assignment <- rep(chamber_inoc, base_count) #assigning treatments based on the based count
if(remainder > 0){
assignment <- c(assignment, sample(chamber_inoc, remainder)) #if there are remaining individuals, it randomly assigns treatments across them
}
sample(assignment)  #shuffles the list of chamber_inoc to further randomize it
}
#applying the randomly selected sub_blocks (1 and 2) to each block/maternal line
seedling_dataframe_rand_dan_drought.no.fire.under.24 <- seedling_dataframe_rand_dan_drought.no.fire.under.24 %>%
group_by(block, Treatment, Sub_blocks, Inoculation_run) %>% #sub_blocks are just the maternal line / species of an individual
mutate(Chamber_inoc = even_randomize_chamber(n(), chamber_inoc)) %>% #sets the sub_blocks column equal to the assignment output of the even_randomize_blocks function
ungroup()
# Check distribution
table_5 <- table(seedling_dataframe_rand_dan_drought.no.fire.under.24$block,
seedling_dataframe_rand_dan_drought.no.fire.under.24$Treatment,
seedling_dataframe_rand_dan_drought.no.fire.under.24$Sub_blocks,
seedling_dataframe_rand_dan_drought.no.fire.under.24$Inoculation_run,
seedling_dataframe_rand_dan_drought.no.fire.under.24$Chamber_inoc)
table_5
#creating a dataframe of the counts across block/treatment/sub-block
df_5 <- as.data.frame(table_5)
colnames(df_5) <- c("Block", "Treatment", "Sub.block", "Inoculation.Run", "Inoculation.Chamber", "Count")
#creating a dataframe totalling the number of seedlings per block/treatment/sub-block
table_df_5 <- df_5 %>%
arrange(Block, Treatment, Sub.block, Inoculation.Run) %>%
summarise(sum = sum(Count), .by = c(Block, Treatment, Sub.block, Inoculation.Run, Inoculation.Chamber))
#adding an individual number ID across all of the seedlings, regardless of species
seedling_dataframe_rand_dan_drought.no.fire.under.24 <- seedling_dataframe_rand_dan_drought.no.fire.under.24 %>%
group_by(Species, Treatment, Sub_blocks) %>% #grouping them by species, treatment, and subblocks before assigning locations
mutate(block_number = row_number()) %>% #assigning locations based on row number
mutate(block_number = sample(block_number, replace = F)) #shuffling the locations
View(seedling_dataframe_rand_dan_drought.no.fire.under.24 %>%
arrange(Treatment, Species, Sub_blocks))
nrow(seedling_dataframe_rand_dan_drought)
