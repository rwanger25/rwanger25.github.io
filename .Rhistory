#loblolly (we are sowing more of the ones with <30 so we are more specific about what we are using for Dan's)
loblolly.greater.30 <- c("6.Loblolly",  "8.Loblolly",  "11.Loblolly",
"19.Loblolly", "20.Loblolly", "22.Loblolly", "23.Loblolly", "25.Loblolly",
"26.Loblolly","27.Loblolly", "28.Loblolly", "29.Loblolly", "34.Loblolly",
"38.Loblolly", "40.Loblolly", "44.Loblolly",
"46.Loblolly", "47.Loblolly", "48.Loblolly", "51.Loblolly") #we can take 10 seedlings from these
loblolly.great.24.less.30 <- c("2.Loblolly", "4.Loblolly", "45.Loblolly") #we can take until these reach 24 seedlings from these (so there is still 5-6 available per treatment in the drought x pathogen experiment)
loblolly.great.18.less.24 <- c("13.Loblolly") #we can take until these reach 16 seedlings from these (so there is still 4 available per treatment in the drought x pathogen experiment)
loblolly.great.12.less.18 <- c("36.Loblolly") #we can take until these reach 12 seedlings from these (so there is still 2 available per treatment in the drought x pathogen experiment)
loblolly.less.6 <- c("16.Loblolly") #we can take all, until these reach 0 seedlings from these
longleaf.greater.30 <- c("37.Longleaf", "38.Longleaf", "39.Longleaf", "40.Longleaf")  #we can take 10 seedlings from these
longleaf.great.24.less.30 <- c("36.Longleaf", "52.Longleaf") #we want to take 8, take until X-8
longleaf.great.18.less.24 <- c("17.Longleaf", "26.Longleaf",  "27.Longleaf") #we want to take 6, take until X-6
longleaf.great.12.less.18 <- c("1.Longleaf", "4.Longleaf", "5.Longleaf",  #we want to take 4, take until X-4
"7.Longleaf", "18.Longleaf", "21.Longleaf",
"30.Longleaf", "31.Longleaf", "34.Longleaf", "46.Longleaf") #"3.Longleaf", "11.Longleaf",
#setting the seed to maintain the same randomization results for the future
set.seed(25)
#setting a base number
iteration = 0
#making sure Dan's list is a character
dan.list <- as.character(dan.list)
#creating an empty dataframe to store rows that were decided to be in Dan's experiment
seedling_dataframe_rand_dan_drought.FIRE.only <- tibble()
while(length(dan.list) != 0){
#this iterates so we remove one row from each maternal line still in dan.list (still have more than can be removed for Dan's experiment)
for (i in 1:length(dan.list)){
#randomly selecting a row within each of the maternal lines in the dan.list that will be kept in his experiment
seedling_dataframe_rand_dan_drought.FIRE.i <- seedling_dataframe_rand_dan_drought.FIRE %>%
ungroup() %>%
mutate(block = as.character(block)) %>%
filter(block == as.character(dan.list[i])) %>% #select the rows for current maternal line
slice_sample(n=1) #randomly select a row
#remove the randomly selected row from the dataframe for the drought x pathogen experiment
seedling_dataframe_rand_dan_drought.FIRE <- seedling_dataframe_rand_dan_drought.FIRE %>%
filter(!(Unique_ID == seedling_dataframe_rand_dan_drought.FIRE.i$Unique_ID))
#adding the row to a dataframe
seedling_dataframe_rand_dan_drought.FIRE.only <- rbind(seedling_dataframe_rand_dan_drought.FIRE.only,
seedling_dataframe_rand_dan_drought.FIRE.i)
}
#if a maternal should not longer have any rows removed, we remove it from dan.list
iteration = iteration + 1
#if we have taken the number of rows we need from each maternal line, we remove them from the Dan.list
if (iteration == 10){
dan.list = dan.list[!(dan.list %in% loblolly.greater.30) & !(dan.list %in% longleaf.greater.30)]
}
if (iteration == 8){
dan.list = dan.list[!(dan.list %in% longleaf.great.24.less.30)]
}
if (iteration == 6){
dan.list = dan.list[!(dan.list %in% longleaf.great.18.less.24)]
}
if (iteration == 4){
dan.list = dan.list[!(dan.list %in% longleaf.great.12.less.18)]
}
# creating the update dan.list
# Treatments
treatments <- c("Control-Control", "Drought-Control",
"Control-Inoculation", "Drought-Inoculation")
#applying the randomly selected treatments to each block (i.e. maternal line 1-Loblolly, maternal line 1-Longleaf)
seedling_dataframe_rand_dan_drought.FIRE <- seedling_dataframe_rand_dan_drought.FIRE %>%
group_by(block) %>% #blocks are just the maternal line / species of an individual
mutate(Treatment = even_randomize(n(), treatments)) %>% #sets the treatment column equal to the assignment output of the even_randomize function
ungroup()
# Check distribution
table_2 <- table(seedling_dataframe_rand_dan_drought.FIRE$block, seedling_dataframe_rand_dan_drought.FIRE$Treatment)
table_2
#visualization the distribution
df_2 <- as.data.frame(table_2)
colnames(df_2) <- c("block", "Treatment", "Count")
#creating a dataframe totaling the number of seedlings per species/maternal line
table_df_2 <- df_2 %>%
arrange(block) %>%
summarise(sum = sum(Count), .by = block)
#removing the treatment column to avoid conflict of column numbers
seedling_dataframe_rand_dan_drought.FIRE <- subset(seedling_dataframe_rand_dan_drought.FIRE, select = -Treatment)
#removing maternal lines when we have taken the correct number of rows out
if (table_df_2$sum[table_df_2$block == "2.Loblolly"] == 24){
dan.list = dan.list[dan.list!="2.Loblolly"]
}
if (table_df_2$sum[table_df_2$block == "4.Loblolly"] == 24){
dan.list = dan.list[dan.list!="4.Loblolly"]
}
if (table_df_2$sum[table_df_2$block == "45.Loblolly"] == 24){
dan.list = dan.list[dan.list!="45.Loblolly"]
}
if (table_df_2$sum[table_df_2$block %in% loblolly.great.18.less.24] == 16){
dan.list = dan.list[dan.list!=loblolly.great.18.less.24]
}
if (table_df_2$sum[table_df_2$block %in% loblolly.great.12.less.18] == 12){
dan.list = dan.list[dan.list!=loblolly.great.12.less.18]
}
if (table_df_2$sum[table_df_2$block %in% loblolly.less.6] == 0){
dan.list = dan.list[dan.list!=loblolly.less.6]
}
}
# now we remove the rows that were in the original dan.list and replace them with this dataframe which has rows remove for the fire experiment
seedling_dataframe_rand_dan_drought.FIRE.new <- seedling_dataframe_rand_dan_drought %>%
filter(!(block %in% dan.list.original)) #removing blocks that were in the origninal list
#adding rows in from the cleaned maternal lines
seedling_dataframe_rand_dan_drought.FIRE.new <- rbind(seedling_dataframe_rand_dan_drought.FIRE.new, seedling_dataframe_rand_dan_drought.FIRE)
# checking for unique unique IDs to check for duplicate issues
anyDuplicated(seedling_dataframe_rand_dan_drought.FIRE.new$Unique_ID)
#currently there are duplicates
duplicates <- which(duplicated((seedling_dataframe_rand_dan_drought.new$Unique_ID)))
duplicates
#looking at the duplicated IDS
seedling_dataframe_rand_dan_drought.new$Unique_ID[c(duplicates)]
length(duplicates)
#setting the seed
set.seed(25)
#applying the randomly selected treatments to each block (i.e. maternal line 1-Loblolly, maternal line 1-Longleaf)
seedling_dataframe_rand_dan_drought.FIRE.new <- seedling_dataframe_rand_dan_drought.FIRE.new %>%
group_by(block) %>% #blocks are just the maternal line / species of an individual
mutate(Treatment = even_randomize(n(), treatments)) %>% #sets the treatment column equal to the assignment output of the even_randomize function
ungroup()
# Check distribution
