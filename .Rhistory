base_count <- floor(n / length(inoculation_run)) #minimum of individuals per treatment by dividing total number in, floor rounds down
remainder  <- n %% length(inoculation_run) # finding the remaining individuals that could not be evenly distributed across the treatments
assignment <- rep(inoculation_run, base_count) #assigning treatments based on the based count
if(remainder > 0){
assignment <- c(assignment, sample(inoculation_run, remainder)) #if there are remaining individuals, it randomly assigns treatments across them
}
sample(assignment)  #shuffles the list of inoculation_run to further randomize it
}
