# Sub-sub-subet Blocks
sub_blocks <- c("Block 1", "Block 2")
#setting the seed
set.seed(25)
# creating a function to assign treatments as evenly as possible
even_randomize_blocks <- function(n, sub_blocks) { #inputs number of individuals in a block and 4 treatment labels
base_count <- floor(n / length(sub_blocks)) #minimum of individuals per treatment by dividing total number in, floor rounds down
remainder  <- n %% length(sub_blocks) # finding the remaining individuals that could not be evenly distributed across the treatments
assignment <- rep(sub_blocks, base_count) #assigning treatments based on the based count
if(remainder > 0){
assignment <- c(assignment, sample(sub_blocks, remainder)) #if there are remaining individuals, it randomly assigns treatments across them
}
sample(assignment)  #shuffles the list of sub_blocks to further randomize it
}
#applying the randomly selected sub_blocks (1 and 2) to each block/maternal line
seedling_dataframe_rand_dan_drought.no.fire.under.24 <- seedling_dataframe_rand_dan_drought.no.fire.under.24 %>%
group_by(Treatment, block) %>% #sub_blocks are just the maternal line / species of an individual
mutate(Sub_blocks = even_randomize_blocks(n(), sub_blocks)) %>% #sets the sub_blocks column equal to the assignment output of the even_randomize_blocks function
ungroup()
# Check distribution
table_3 <- table(seedling_dataframe_rand_dan_drought.no.fire.under.24$block,
seedling_dataframe_rand_dan_drought.no.fire.under.24$Treatment,
seedling_dataframe_rand_dan_drought.no.fire.under.24$Sub_blocks)
table_3
