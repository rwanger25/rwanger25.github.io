# Sub-sub-subet Blocks
treatments_dan <- c("Fire-Control", "Fire-Drought")
#setting the seed
set.seed(25)
even_randomize_dan <- function(n, treatments_dan) { #inputs number of individuals in a block and 4 treatment labels
base_count <- floor(n / length(treatments_dan)) #minimum of individuals per treatment by dividing total number in, floor rounds down
remainder  <- n %% length(treatments_dan) # finding the remaining individuals that could not be evenly distributed across the treatments
assignment <- rep(treatments_dan, base_count) #assigning treatments based on the based count
if(remainder > 0){
assignment <- c(assignment, sample(treatments_dan, remainder)) #if there are remaining individuals, it randomly assigns treatments across them
}
sample(assignment)  #shuffles the list of treatments_dan to further randomize it
}
treatments_dan
assignment <- c(assignment, sample(treatments_dan, remainder)) #if there are remaining individuals, it randomly assigns treatments across them
even_randomize_dan <- function(n, treatments_dan) { #inputs number of individuals in a block and 4 treatment labels
base_count <- floor(n / length(treatments_dan)) #minimum of individuals per treatment by dividing total number in, floor rounds down
remainder  <- n %% length(treatments_dan) # finding the remaining individuals that could not be evenly distributed across the treatments
assignment <- rep(treatments_dan, base_count) #assigning treatments based on the based count
if(remainder > 0){
assignment <- c(assignment, sample(treatments_dan, remainder)) #if there are remaining individuals, it randomly assigns treatments across them
}
sample(assignment)  #shuffles the list of treatments_dan to further randomize it
}
#applying the randomly selected treatments to each block (i.e. maternal line 1-Loblolly, maternal line 1-Longleaf)
seedling_dataframe_rand_dan_drought.DAN <- seedling_dataframe_rand_dan_drought.DAN %>%
group_by(block) %>% #blocks are just the maternal line / species of an individual
mutate(Treatment = even_randomize_dan(n(), treatments_dan)) %>% #sets the treatment column equal to the assignment output of the even_randomize function
ungroup()
# Check distribution
table_6 <- table(seedling_dataframe_rand_dan_drought.DAN$block, seedling_dataframe_rand_dan_drought.DAN$Treatment)
table_6
#adding an individual number ID across all of the seedlings, regardless of species, blocking, treatment, completely randomized
seedling_dataframe_rand_dan_drought.DAN <- seedling_dataframe_rand_dan_drought.DAN %>%
mutate(block_number = row_number()) %>% #assigning locations based on row number
mutate(block_number = sample(block_number, replace = F)) #shuffling the locations
#adding an individual number ID across all of the seedlings, regardless of species, blocking, treatment, completely randomized
seedling_dataframe_rand_dan_drought.DAN <- seedling_dataframe_rand_dan_drought.DAN %>%
mutate(location_number = row_number()) %>% #assigning locations based on row number
mutate(location_number = sample(location_number, replace = F)) #shuffling the locations
View(seedling_dataframe_rand_dan_drought.DAN)
