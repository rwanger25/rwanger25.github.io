#we store the list of maternal lines with over 24 seedlings
over.24 <- c() #creating an empty list
over.24 <- list(subset(table_df_2, sum >24)$block)[[1]]
over.24.original <- over.24
#filtering the dataframe for blocks that have over 24 seedlings
seedling_dataframe_rand_dan_drought.FIRE.new.24 <- subset(seedling_dataframe_rand_dan_drought.FIRE.new, block %in% over.24)
#setting the seed
set.seed(25)
#we delete rows in seedling_dataframe_rand_dan_drought until no more maternal lines have over 24 seedlings (randomly selecting which seedlings we do not include)
while(length(over.24) != 0){
# we should randomly select one row from each block within the over.24 list and delete it
# until we only have maternal lines with 24 or less seedlings
for (i in length(over.24)){
#randomly deleting a row within each of the maternal lines in the over.24 list
seedling_dataframe_rand_dan_drought.FIRE.new.24.i <- seedling_dataframe_rand_dan_drought.FIRE.new.24 %>%
mutate(block = as.character(block)) %>%
filter(block == as.character(over.24[i])) %>% #select the rows for current maternal line
slice_sample(n=1) #randomly select a row to delete
#remove the randomly selected row from the dataframe
seedling_dataframe_rand_dan_drought.FIRE.new.24 <- seedling_dataframe_rand_dan_drought.FIRE.new.24 %>%
filter(!(Unique_ID == seedling_dataframe_rand_dan_drought.FIRE.new.24.i$Unique_ID))
}
# creating the update over.24 list
# Treatments
treatments <- c("Control-Control", "Drought-Control",
"Control-Inoculation", "Drought-Inoculation")
# creating a function to assign treatments as evenly as possible
even_randomize <- function(n, treatments) { #inputs number of individuals in a block and 4 treatment labels
base_count <- floor(n / length(treatments)) #minimum of individuals per treatment by dividing total number in, floor rounds down
remainder  <- n %% length(treatments) # finding the remaining individuals that could not be evenly distributed across the treatments
assignment <- rep(treatments, base_count) #assigning treatments based on the based count
if(remainder > 0){
assignment <- c(assignment, sample(treatments, remainder)) #if there are remaining individuals, it randomly assigns treatments across them
}
sample(assignment)  #shuffles the list of treatments to further randomize it
}
#applying the randomly selected treatments to each block (i.e. maternal line 1-Loblolly, maternal line 1-Longleaf)
seedling_dataframe_rand_dan_drought.FIRE.new.24 <- seedling_dataframe_rand_dan_drought.FIRE.new.24 %>%
group_by(block) %>% #blocks are just the maternal line / species of an individual
mutate(Treatment = even_randomize(n(), treatments)) %>% #sets the treatment column equal to the assignment output of the even_randomize function
ungroup()
# Check distribution
table_2 <- table(seedling_dataframe_rand_dan_drought.FIRE.new.24$block, seedling_dataframe_rand_dan_drought.FIRE.new.24$Treatment)
table_2
#visualization the distribution
df_2 <- as.data.frame(table_2)
colnames(df_2) <- c("block", "Treatment", "Count")
#creating a dataframe totalling the number of seedlings per species/maternal line
table_df_2 <-df_2 %>%
arrange(block) %>%
summarise(sum = sum(Count), .by = block)
#creating the new over.24 after each maternal line lost a row at random
over.24 <- list(subset(table_df_2, sum >24)$block)[[1]]
}
