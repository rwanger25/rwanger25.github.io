# Check distribution
table_2 <- table(seedling_dataframe_rand_dan_drought.FIRE.new$block, seedling_dataframe_rand_dan_drought.FIRE.new$Treatment)
table_2
#visualization the distribution
df_2 <- as.data.frame(table_2)
